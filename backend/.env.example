# ──────────────────────────────────────────────
# OpenAI — REQUERIDO
# Se usa para: OCR de PDFs escaneados y Wukong (extracción de entidades).
# Pegar la key TAL CUAL, sin comillas.
# Ejemplo: OPENAI_API_KEY=sk-proj-abc123...
# ──────────────────────────────────────────────
OPENAI_API_KEY=

# ──────────────────────────────────────────────
# Supabase — Base de datos + Storage
# ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ──────────────────────────────────────────────
# Auth0 — Autenticación
# ──────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://your-api-identifier

AUTH0_M2M_CLIENT_ID=tu_client_id_de_la_app_machine_to_machine
AUTH0_M2M_CLIENT_SECRET=tu_client_secret

# ──────────────────────────────────────────────
# MillenniumDB — Servidores del IMFD
# Conexión via WebSocket (driver oficial)
# Puerto default de mdb server: 1234
# ──────────────────────────────────────────────
MILLENNIUMDB_HOST=localhost
MILLENNIUMDB_PORT=1234

# ──────────────────────────────────────────────
# GCP Cloud Tasks — Pipeline asíncrono
# ──────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project
CLOUD_TASKS_QUEUE=your-queue-name
CLOUD_TASKS_LOCATION=us-central1

# ──────────────────────────────────────────────
# Wukong — depuración local (opcional)
# Si se define, tras cada run se copia el workdir completo aquí (textos + exports/*.qm).
# Ruta relativa a backend/ o absoluta. En producción: comentar o dejar vacío.
# ──────────────────────────────────────────────
WUKONG_ARTIFACTS_DIR=wukong_artifacts

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
DEBUG=true
