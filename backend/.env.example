# ──────────────────────────────────────────────
# OpenAI — REQUERIDO
# Se usa para: OCR de PDFs escaneados y Wukong (extracción de entidades).
# Pegar la key TAL CUAL, sin comillas.
# Ejemplo: OPENAI_API_KEY=sk-proj-abc123...
# ──────────────────────────────────────────────
OPENAI_API_KEY=

# ──────────────────────────────────────────────
# Supabase — Base de datos + Storage
# ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ──────────────────────────────────────────────
# Auth0 — Autenticación
# ──────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://your-api-identifier

AUTH0_M2M_CLIENT_ID=tu_client_id_de_la_app_machine_to_machine
AUTH0_M2M_CLIENT_SECRET=tu_client_secret

# ──────────────────────────────────────────────
# MillenniumDB — Servidores del IMFD
# Conexión via WebSocket (driver oficial)
# Puerto default de mdb server: 1234
# ──────────────────────────────────────────────
MILLENNIUMDB_HOST=localhost
MILLENNIUMDB_PORT=1234

# Wukong — opcional (dev): carpeta bajo backend/ donde copiar el workdir tras procesar
WUKONG_ARTIFACTS_DIR=
# El .qm exportado por Wukong se sube al bucket documentos en:
#   {JWT sub con |→_}/{collection_id}/{collection_id}.qm  (igual que documentos)
# Aplicar migración supabase/migrations/005_collection_qm_storage.sql (columna qm_storage_path).

# ──────────────────────────────────────────────
# GCP Cloud Tasks — Pipeline asíncrono
# Crear cola: infra/cloud_tasks/setup.sh
# Sin CLOUD_TASKS_*: en DEBUG el backend usa hilos locales (monolito).
# Split API/worker en local: IMFD_SERVICE_ROLE=api + DEV_WORKER_HTTP_URL=http://127.0.0.1:8081
#   (ver infra/local/run-split.sh; worker en otro terminal con IMFD_SERVICE_ROLE=worker).
# ──────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project
CLOUD_TASKS_QUEUE=imfd-processing-v2
CLOUD_TASKS_LOCATION=us-central1
# URL pública de Cloud Run, ej. https://imfd-backend-xxxxx-uc.a.run.app
CLOUD_TASKS_SERVICE_URL=
CLOUD_TASKS_WORKER_URL=
CLOUD_TASKS_INVOKER_SA=imfd-tasks-invoker@your-gcp-project.iam.gserviceaccount.com
IMFD_SERVICE_ROLE=all
DEV_WORKER_HTTP_URL=

# ──────────────────────────────────────────────
# HU-13: Resiliencia de carga — OPCIONAL
# Número máximo de reintentos ante fallo de Supabase Storage (default: 3)
# Retardo inicial entre reintentos en segundos; se duplica por cada intento (default: 1.0)
# ──────────────────────────────────────────────
MAX_UPLOAD_RETRIES=3
UPLOAD_RETRY_DELAY_SECONDS=1.0
# Wukong — depuración local (opcional)
# Si se define, tras cada run se copia el workdir completo aquí (textos + exports/*.qm).
# Ruta relativa a backend/ o absoluta. En producción: comentar o dejar vacío.
# ──────────────────────────────────────────────
WUKONG_ARTIFACTS_DIR=wukong_artifacts

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
DEBUG=true

# Google Cloud Vision API
GOOGLE_APPLICATION_CREDENTIALS=gcp-vision-key.json
GCP_PROJECT_ID=your-gcp-project-id

# ──────────────────────────────────────────────
# HU-09: Idioma OCR — OPCIONAL
# Hints de idioma de fallback para Cloud Vision cuando una colección no tiene
# idioma configurado o el código no está en OCR_SUPPORTED_LANGUAGES.
# Lista separada por comas de códigos BCP-47 (https://cloud.google.com/vision/docs/languages).
# El idioma por colección se configura en el frontend al crear la colección
# y queda almacenado en la columna `language` de la tabla `collections`.
# ──────────────────────────────────────────────
# OCR — DPI y idiomas (opcional; defaults: 300 / 400 / es,en)
OCR_DPI_DEFAULT=300
OCR_DPI_COMPLEX=400
OCR_LANGUAGE_HINTS=es,en